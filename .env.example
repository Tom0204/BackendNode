# Environnement d'exécution : development | test | production
NODE_ENV=development

# Port d'écoute du serveur HTTP
PORT=4001

# Niveau de journalisation : fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Origines autorisées par CORS, séparées par des virgules (FND-08).
# Format : http(s)://hôte[:port], sans chemin, sans / final, sans identifiants. Le joker * est interdit.
# Non définie : toutes les origines en development et test, AUCUNE en production.
# CORS ne concerne que les navigateurs : Postman et curl ne sont jamais bloqués.
# CORS_ORIGINS=https://jeu.example.com,https://admin.example.com

# --- Base de données PostgreSQL (DB-01, voir docs/architecture/database.md) ---
# Valeurs FACTICES : copiez ce fichier en .env et choisissez votre propre mot de passe.

# Conteneur Docker local (docker-compose.yml, lancé par « npm run db:up »)
POSTGRES_USER=mmorpg
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Connexion de l'application. Obligatoire en development et production (facultative en test).
# Utilisateur, mot de passe et port identiques aux valeurs POSTGRES_* ci-dessus.
DATABASE_URL=postgresql://mmorpg:change-me@localhost:5432/mmorpg_dev

# Tests base de données uniquement (« npm run test:db »). Jamais lue par l'application.
# Base exactement mmorpg_test, hôte local, sans paramètres : toute autre valeur est refusée.
TEST_DATABASE_URL=postgresql://mmorpg:change-me@localhost:5432/mmorpg_test

# --- Authentification (AUTH-05) ---
# Durée de vie absolue d'une session de connexion, en heures (entier de 1 à 720). Par défaut : 24.
# Aucun secret n'est nécessaire : les jetons sont aléatoires et seule leur empreinte est stockée en base.
# SESSION_TTL_HOURS=24
