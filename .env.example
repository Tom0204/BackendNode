# Environnement d'exécution : development | test | production
NODE_ENV=development

# Port d'écoute du serveur HTTP
PORT=4001

# Niveau de journalisation : fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Origines autorisées par CORS, séparées par des virgules (FND-08).
# Format : http(s)://hôte[:port], sans chemin, sans / final, sans identifiants. Le joker * est interdit.
# Non définie : toutes les origines en development et test, AUCUNE en production.
# CORS ne concerne que les navigateurs : Postman et curl ne sont jamais bloqués.
# CORS_ORIGINS=https://jeu.example.com,https://admin.example.com