{
 "name": "nodejs-express",
 "version": "1.0.0",
 "description": "Node.js Express application",
 "type": "module",
 "main": "server.ts",
 "scripts": {
   "dev": "nodemon --watch . -e js,ts,json --exec \"ts-node server.ts\"",
   "build": "tsup server.ts --format cjs --clean",
   "start": "node dist/server.js"
  },
  "dependencies": {
  "express": "^4.18.2",
  "nodemon": "^3.0.3"

  },
  "devDependencies": {
  "@types/cors": "^2.8.17",
  "@types/express": "^4.17.21",
  "@types/node": "^20.11.7",
  "tsup": "^8.0.1",
  "typescript": "^5.3.3"
  }
}