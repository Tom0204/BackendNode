{
 "name": "nodejs-express",
 "version": "1.0.0",
 "description": "Node.js Express application",
 "type": "module",
 "main": "dist/server.cjs",
 "scripts": {
  "dev": "nodemon --watch . -e js,ts,json --exec \"tsx watch server.ts\"",
  "typecheck": "tsc --noEmit",
  "build": "npm run typecheck && tsup server.ts --format cjs --clean",
  "start": "node dist/server.cjs",
  "test": "vitest run"
 },
 "dependencies": {
  "cors": "^2.8.6",
  "express": "^4.18.2",
  "express-rate-limit": "^8.7.4",
  "helmet": "^8.3.0",
  "nodemon": "^3.0.3",
  "pino": "^10.4.0",
  "pino-http": "^11.0.0",
  "zod": "^4.6.7"
 },
 "devDependencies": {
  "@types/cors": "^2.8.17",
  "@types/express": "^4.17.21",
  "@types/node": "^22.20.5",
  "@types/supertest": "^7.2.1",
  "pino-pretty": "^13.2.0",
  "supertest": "^7.3.2",
  "ts-node": "^10.9.2",
  "tsup": "^8.0.1",
  "tsx": "^4.23.15",
  "typescript": "^5.3.3",
  "vitest": "^5.1.0"
 }
}
